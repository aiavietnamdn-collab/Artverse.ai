rules_version = '2';

// ARTVERSE AI — Firebase Storage Security Rules (STORAGE MANAGEMENT & UPLOAD ENGINE REBUILD)
// Kiểm soát định dạng và dung lượng tệp tải lên cho Tác phẩm (Ảnh <=12MB, Video <=100MB), Slide (<=25MB) và Video bài học (<=100MB)
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidArtworkImage() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)') &&
             request.resource.size <= 12 * 1024 * 1024; // Tối đa 12MB
    }

    function isValidArtworkVideo() {
      return request.resource.contentType.matches('video/(mp4|quicktime|webm|x-m4v)') &&
             request.resource.size <= 100 * 1024 * 1024; // Tối đa 100MB theo yêu cầu Phần 4
    }

    function isValidArtworkMedia() {
      return isValidArtworkImage() || isValidArtworkVideo();
    }

    function isValidLessonSlide() {
      return (request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)') ||
              request.resource.contentType == 'application/pdf' ||
              request.resource.contentType == 'application/vnd.ms-powerpoint' ||
              request.resource.contentType == 'application/vnd.openxmlformats-officedocument.presentationml.presentation') &&
             request.resource.size <= 25 * 1024 * 1024; // Tối đa 25MB
    }

    function isValidLessonVideo() {
      return request.resource.contentType.matches('video/.*') &&
             request.resource.size <= 100 * 1024 * 1024; // Tối đa 100MB
    }

    // 1. Tác phẩm công khai trong Triển lãm (Ảnh đã khử EXIF/GPS, Thumbnail hoặc Video tác phẩm <=100MB)
    match /public_exhibition/{artworkId}/{fileName} {
      allow read: if true;
      allow write: if isValidArtworkMedia();
      allow delete: if true;
    }

    // 1b. Đường dẫn tương thích cho tác phẩm (artworks/{uploaderId}/{artworkId}/{visibility}/{fileName})
    match /artworks/{uploaderId}/{artworkId}/{visibility}/{fileName} {
      allow read: if visibility == 'public' || isSignedIn();
      allow write: if isValidArtworkMedia();
      allow delete: if isSignedIn();
    }

    // 2. Bản lưu gốc của Giáo viên / Lớp học
    match /private_artworks/{uploaderId}/{artworkId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isValidArtworkMedia();
      allow delete: if isSignedIn();
    }

    // 3. Học liệu Bài giảng: Bộ Slide & Tài liệu trình chiếu (Lớp 1 -> Lớp 9)
    match /lesson_media/{lessonId}/slides/{fileName} {
      allow read: if true;
      allow write: if isValidLessonSlide();
      allow delete: if isSignedIn();
    }

    match /lessons/{lessonId}/slides/{fileName} {
      allow read: if true;
      allow write: if isValidLessonSlide();
      allow delete: if isSignedIn();
    }

    // 4. Học liệu Bài giảng: Video hướng dẫn thực hành (Lớp 1 -> Lớp 9, <= 100MB)
    match /lesson_media/{lessonId}/videos/{fileName} {
      allow read: if true;
      allow write: if isValidLessonVideo();
      allow delete: if isSignedIn();
    }

    match /lessons/{lessonId}/videos/{fileName} {
      allow read: if true;
      allow write: if isValidLessonVideo();
      allow delete: if isSignedIn();
    }

    // Mặc định từ chối các đường dẫn không hợp lệ
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
