# ============================================================================
# 1. BIẾN BÍ MẬT BẮT BUỘC TRÊN PRODUCTION (CLOUD RUN / SECRET MANAGER)
#    Tuyệt đối không đặt khóa thật vào tệp này hoặc đẩy lên GitHub.
# ============================================================================

# GEMINI_API_KEY: Khóa API Google Gemini (chỉ đọc tại Backend Express, không bao giờ gửi xuống trình duyệt).
GEMINI_API_KEY=""

# STUDENT_SESSION_SECRET: Khóa bí mật HMAC-SHA256 (tối thiểu 32 ký tự ngẫu nhiên, tạo bằng: openssl rand -hex 32)
# dùng để ký & xác thực phiên đăng nhập của học sinh. Hệ thống KHÔNG dùng giá trị mặc định cố định khi chạy production.
STUDENT_SESSION_SECRET=""

# ============================================================================
# 2. CẤU HÌNH FIREBASE AUTHENTICATION, FIRESTORE & FIREBASE ADMIN SDK
# ============================================================================

# FIREBASE_PROJECT_ID: ID dự án Firebase thực tế (mặc định đọc từ firebase-applet-config.json nếu để trống).
FIREBASE_PROJECT_ID="static-shade-tpz3c"

# FIRESTORE_DATABASE_ID: ID cơ sở dữ liệu Cloud Firestore thực tế (mặc định đọc từ firebase-applet-config.json).
FIRESTORE_DATABASE_ID="ai-studio-artverseaidyhcmt-db85d15f-8546-4095-b89f-4c8e18943c8c"

# FIREBASE_SERVICE_ACCOUNT_JSON: (Tùy chọn) Chuỗi JSON của Service Account.
# - Khi chạy trên Google Cloud Run: ĐỂ TRỐNG để hệ thống tự động ưu tiên dùng Application Default Credentials (ADC)
#   của Service Account gắn với Cloud Run (với quyền tối thiểu: Firebase Auth Admin & Service Account Token Creator).
# - Chỉ cấu hình biến này qua Secret Manager khi chạy ngoài Google Cloud hoặc dùng Service Account độc lập.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# REQUIRE_FIREBASE_AUTH: Bắt buộc xác thực Firebase ID Token / Student Session Token tại backend (luôn là "true" ở production).
REQUIRE_FIREBASE_AUTH="true"

# BOOTSTRAP_ADMIN_EMAIL: Email Google của Quản trị viên hệ thống cao nhất.
BOOTSTRAP_ADMIN_EMAIL="aiavietnam.dn@gmail.com"

# ============================================================================
# 3. GIỚI HẠN TRUY CẬP (RATE LIMIT), CHỐNG DÒ PIN & HẠN MỨC GEMINI HỌC SINH
#    (Tất cả các biến dưới đây đều có giá trị mặc định an toàn trong server.ts)
# ============================================================================

# Cửa sổ thời gian tính giới hạn tần suất (mili-giây, mặc định 60000 = 60 giây).
RATE_LIMIT_WINDOW_MS="60000"

# Giới hạn số yêu cầu gọi /api/gemini/chat tối đa trong 60 giây (mặc định 20 lần / 60 giây).
RATE_LIMIT_MAX_GEMINI="20"

# Giới hạn số yêu cầu gọi API chung tối đa trong 60 giây (mặc định 120 lần / 60 giây).
RATE_LIMIT_MAX_API="120"

# Giới hạn số lần thử đăng nhập học sinh tối đa từ một IP trong 60 giây (mặc định 10 lần / 60 giây).
RATE_LIMIT_MAX_STUDENT_LOGIN="10"

# Số lần nhập sai mã PIN tối đa trước khi khóa tạm thời tài khoản học sinh (mặc định 5 lần).
MAX_FAILED_PIN_ATTEMPTS="5"

# Thời gian khóa tạm thời tài khoản học sinh khi nhập sai PIN quá giới hạn (mặc định 900000 ms = 15 phút).
PIN_LOCKOUT_DURATION_MS="900000"

# Số vòng lặp băm mã PIN bằng thuật toán bcrypt (mặc định 10, phạm vi an toàn 10-14).
BCRYPT_ROUNDS="10"

# Giới hạn kích thước dữ liệu JSON gửi lên máy chủ (mặc định 4mb).
MAX_REQUEST_BODY_SIZE="4mb"

# Hạn mức số câu hỏi Gemini tối đa mỗi ngày cho TỪNG học sinh độc lập (mặc định 10 lượt/ngày/học sinh).
GEMINI_DAILY_LIMIT_PER_STUDENT="10"

# Ngân sách tham chiếu hàng tháng cho Gemini AI (USD, mặc định 25).
GEMINI_MONTHLY_BUDGET_USD="25"

# ============================================================================
# 4. CẤU HÌNH MÁY CHỦ CLOUD RUN, TÊN MIỀN RIÊNG & CORS
# ============================================================================

# NODE_ENV: Đặt là "production" khi chạy trên Google Cloud Run.
NODE_ENV="production"

# PORT: Cổng HTTP máy chủ (Cloud Run tự động gán PORT=8080; môi trường dev mặc định 3000).
PORT="3000"

# APP_URL: Tên miền chính thức của ứng dụng (dùng cho liên kết chia sẻ & QR).
APP_URL="https://artverseai.vn"

# ALLOWED_ORIGINS: Danh sách các tên miền được phép gọi API qua CORS (phân tách bằng dấu phẩy).
ALLOWED_ORIGINS="https://artverseai.vn,https://www.artverseai.vn,capacitor://localhost,ionic://localhost"

# VITE_API_BASE_URL: (Tùy chọn cho bản đóng gói iOS Capacitor) URL máy chủ backend công khai.
# Để trống "" khi chạy Website/PWA trên cùng tên miền.
VITE_API_BASE_URL=""

