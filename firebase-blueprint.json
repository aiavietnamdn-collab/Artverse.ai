{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Art teacher or student user profile and permissions",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "nickname": { "type": "string", "maxLength": 64 },
        "nicknameNormalized": { "type": "string", "maxLength": 64 },
        "nicknameSetAt": { "type": "string", "maxLength": 64 },
        "nicknameUpdatedAt": { "type": "string", "maxLength": 64 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "role": { "type": "string", "enum": ["viewer", "student", "teacher", "admin"] },
        "classCode": { "type": "string", "maxLength": 32 },
        "classGroupId": { "type": "string", "maxLength": 64 },
        "studentCode": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "enum": ["active", "locked"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "role"]
    },
    "StudentAccount": {
      "title": "StudentAccount",
      "description": "Teacher-created pseudonymous student account with bcrypt PIN hash and creative nickname (no email, phone, DOB, or address)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "classCode": { "type": "string", "maxLength": 32 },
        "classGroupId": { "type": "string", "maxLength": 64 },
        "className": { "type": "string", "maxLength": 128 },
        "studentCode": { "type": "string", "maxLength": 32 },
        "displayName": { "type": "string", "maxLength": 128 },
        "nickname": { "type": "string", "maxLength": 64 },
        "nicknameNormalized": { "type": "string", "maxLength": 64 },
        "nicknameSetAt": { "type": "string", "maxLength": 64 },
        "nicknameUpdatedAt": { "type": "string", "maxLength": 64 },
        "role": { "type": "string", "enum": ["student"] },
        "status": { "type": "string", "enum": ["active", "locked"] },
        "pinHash": { "type": "string", "maxLength": 256 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "lastLoginAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "classCode", "studentCode", "displayName", "role", "status", "pinHash", "teacherId", "createdAt"]
    },
    "CommunityArtwork": {
      "title": "CommunityArtwork",
      "description": "Student artwork exhibited with creative nickname without student real names, emails or rosters",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerKey": { "type": "string", "maxLength": 128 },
        "authorAccountId": { "type": "string", "maxLength": 128 },
        "creatorAnonymousPseudonym": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 2048 },
        "materialsUsed": { "type": "string", "maxLength": 256 },
        "processNotes": { "type": "string", "maxLength": 2048 },
        "classGroupId": { "type": "string", "maxLength": 64 },
        "className": { "type": "string", "maxLength": 128 },
        "lessonId": { "type": "string", "maxLength": 64 },
        "lessonTitle": { "type": "string", "maxLength": 256 },
        "imageUrl": { "type": "string", "maxLength": 4096 },
        "status": { "type": "string", "enum": ["draft", "pending", "approved", "rejected", "hidden", "removed"] },
        "shareStatus": { "type": "string", "enum": ["private", "shared"] },
        "shareToken": { "type": "string", "maxLength": 128 },
        "publishedByTeacherId": { "type": "string", "maxLength": 128 },
        "storageLocation": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "ownerKey", "title", "classGroupId", "lessonId", "status", "shareStatus"]
    },
    "ArtworkStory": {
      "title": "ArtworkStory",
      "description": "Student-written story, emotion, and message linked to a specific artwork in CÂU CHUYỆN TỪ BỨC TRANH",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "artworkId": { "type": "string", "maxLength": 128 },
        "artworkTitle": { "type": "string", "maxLength": 256 },
        "artworkImageUrl": { "type": "string", "maxLength": 4096 },
        "artworkVisualType": { "type": "string", "maxLength": 64 },
        "authorAccountId": { "type": "string", "maxLength": 128 },
        "ownerKey": { "type": "string", "maxLength": 128 },
        "authorNickname": { "type": "string", "maxLength": 64 },
        "classCode": { "type": "string", "maxLength": 32 },
        "classGroupId": { "type": "string", "maxLength": 64 },
        "gradeLabel": { "type": "string", "maxLength": 32 },
        "lessonId": { "type": "string", "maxLength": 64 },
        "lessonTitle": { "type": "string", "maxLength": 256 },
        "topic": { "type": "string", "maxLength": 256 },
        "storyTitle": { "type": "string", "maxLength": 256 },
        "storyContent": { "type": "string", "maxLength": 4096 },
        "viewerMessage": { "type": "string", "maxLength": 1024 },
        "status": { "type": "string", "enum": ["draft", "pending", "approved", "hidden"] },
        "teacherId": { "type": "string", "maxLength": 128 },
        "teacherNote": { "type": "string", "maxLength": 1024 },
        "moderatedBy": { "type": "string", "maxLength": 128 },
        "moderatedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "publishedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "artworkId", "artworkTitle", "authorNickname", "gradeLabel", "storyTitle", "storyContent", "status", "createdAt", "updatedAt"]
    },
    "CommunityClass": {
      "title": "CommunityClass",
      "description": "School class exhibition room",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 1024 },
        "isPublicGalleryEnabled": { "type": "boolean" },
        "isHidden": { "type": "boolean" },
        "artworksCount": { "type": "number" }
      },
      "required": ["id", "name", "isPublicGalleryEnabled", "isHidden"]
    },
    "CommunityLesson": {
      "title": "CommunityLesson",
      "description": "Art lesson reference for grades 1 through 9 with video and slide slots",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "classGroupId": { "type": "string", "maxLength": 64 },
        "className": { "type": "string", "maxLength": 64 },
        "grade": { "type": "string", "enum": ["1", "2", "3", "4", "5", "6", "7", "8", "9"] },
        "title": { "type": "string", "maxLength": 256 },
        "topic": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 2048 },
        "isHidden": { "type": "boolean" },
        "videoUrl": { "type": "string", "maxLength": 500000 },
        "videoFileName": { "type": "string", "maxLength": 256 },
        "videoFileSize": { "type": "number" },
        "videoMimeType": { "type": "string", "maxLength": 128 },
        "videoUpdatedAt": { "type": "string", "maxLength": 64 },
        "slideUrl": { "type": "string", "maxLength": 500000 },
        "slideFileName": { "type": "string", "maxLength": 256 },
        "slideFileSize": { "type": "number" },
        "slideMimeType": { "type": "string", "maxLength": 128 },
        "slideUpdatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "classGroupId", "title"]
    },
    "CommunityAuditLog": {
      "title": "CommunityAuditLog",
      "description": "Audit record for photo upload, security checks, and moderation actions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 64 },
        "targetId": { "type": "string", "maxLength": 128 },
        "targetTitle": { "type": "string", "maxLength": 256 },
        "performedBy": { "type": "string", "maxLength": 128 },
        "performedByRole": { "type": "string", "maxLength": 64 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "details": { "type": "string", "maxLength": 2048 },
        "isSafeOperation": { "type": "boolean" }
      },
      "required": ["id", "action", "targetId", "performedBy", "performedByRole", "timestamp"]
    },
    "ContentReport": {
      "title": "ContentReport",
      "description": "Community user report for inappropriate photo, story, or comment",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "targetType": { "type": "string", "enum": ["artwork", "comment", "story"] },
        "targetId": { "type": "string", "maxLength": 128 },
        "targetTitle": { "type": "string", "maxLength": 256 },
        "reasonCategory": { "type": "string", "maxLength": 64 },
        "reasonLabel": { "type": "string", "maxLength": 256 },
        "details": { "type": "string", "maxLength": 2048 },
        "status": { "type": "string", "enum": ["open", "reviewing", "resolved"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "targetType", "targetId", "reasonCategory", "status", "createdAt"]
    },
    "LessonPlan": {
      "title": "LessonPlan",
      "description": "Art lesson plan authored by an art teacher for GDPT 2018",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "grade": { "type": "string", "maxLength": 32 },
        "level": { "type": "string", "enum": ["primary", "secondary"] },
        "textbook": { "type": "string", "maxLength": 128 },
        "topic": { "type": "string", "maxLength": 256 },
        "durationPeriods": { "type": "number" },
        "learningObjectives": { "type": "string", "maxLength": 2048 },
        "materialsAndEquipment": { "type": "string", "maxLength": 2048 },
        "studentAudienceAndNotes": { "type": "string", "maxLength": 2048 },
        "status": { "type": "string", "enum": ["draft", "approved"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "ownerId", "title", "grade", "level", "topic", "status"]
    },
    "Rubric": {
      "title": "Rubric",
      "description": "Art assessment rubric with 4 achievement levels and criteria",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "grade": { "type": "string", "maxLength": 32 },
        "topic": { "type": "string", "maxLength": 256 },
        "productType": { "type": "string", "maxLength": 128 },
        "evaluationMode": { "type": "string", "enum": ["weighted", "qualitative"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "ownerId", "title", "grade", "topic", "productType", "evaluationMode"]
    },
    "AnonymousSession": {
      "title": "AnonymousSession",
      "description": "Teacher-created assignment session with high-entropy unguessable join token",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 128 },
        "lessonTitle": { "type": "string", "maxLength": 256 },
        "grade": { "type": "string", "maxLength": 32 },
        "topic": { "type": "string", "maxLength": 256 },
        "sessionToken": { "type": "string", "maxLength": 128 },
        "isRevoked": { "type": "boolean" },
        "allowSubmissions": { "type": "boolean" },
        "instructions": { "type": "string", "maxLength": 2048 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "teacherId", "lessonTitle", "sessionToken", "isRevoked"]
    },
    "AnonymousPortfolio": {
      "title": "AnonymousPortfolio",
      "description": "Purely anonymous student portfolio without school roster, real name, email, or DOB",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "sessionId": { "type": "string", "maxLength": 128 },
        "sessionToken": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "portfolioSecretKey": { "type": "string", "maxLength": 128 },
        "anonymousCode": { "type": "string", "maxLength": 64, "pattern": "^ART-[A-Z0-9]{4}-[A-Z0-9]{4}$" },
        "lessonTitle": { "type": "string", "maxLength": 256 },
        "topic": { "type": "string", "maxLength": 256 },
        "grade": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "enum": ["draft", "submitted", "evaluated"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "sessionId", "teacherId", "portfolioSecretKey", "anonymousCode", "lessonTitle", "status"]
    },
    "LivePresentationSession": {
      "title": "LivePresentationSession",
      "description": "Real-time multi-device exhibition presentation session controlled exclusively by the host teacher or admin",
      "type": "object",
      "properties": {
        "sessionCode": { "type": "string", "maxLength": 32 },
        "title": { "type": "string", "maxLength": 256 },
        "hostUid": { "type": "string", "maxLength": 128 },
        "hostDisplayName": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "ended"] },
        "mode": { "type": "string", "enum": ["auto", "manual", "collection"] },
        "currentIndex": { "type": "number" },
        "isPlaying": { "type": "boolean" },
        "intervalSeconds": { "type": "number" },
        "showArtworkInfo": { "type": "boolean" },
        "showAuthorInfo": { "type": "boolean" },
        "showArtworkStory": { "type": "boolean" },
        "pureArtworkOnly": { "type": "boolean" },
        "backdropTheme": { "type": "string", "enum": ["obsidian", "museum_stone"] },
        "filterGrade": { "type": "string", "maxLength": 64 },
        "filterLessonId": { "type": "string", "maxLength": 64 },
        "selectedArtworkIds": { "type": "string", "maxLength": 8192 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["sessionCode", "hostUid", "status", "currentIndex", "isPlaying", "intervalSeconds", "updatedAt"]
    },
    "ArtworkComment": {
      "title": "ArtworkComment",
      "description": "Child-safe moderated community comment under an artwork with creative nickname and zero PII",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "artworkId": { "type": "string", "maxLength": 128 },
        "artworkTitle": { "type": "string", "maxLength": 256 },
        "classId": { "type": "string", "maxLength": 64 },
        "classCode": { "type": "string", "maxLength": 32 },
        "authorUid": { "type": "string", "maxLength": 128 },
        "authorNickname": { "type": "string", "maxLength": 64 },
        "authorRole": { "type": "string", "enum": ["student", "teacher", "admin"] },
        "content": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "isEdited": { "type": "boolean" },
        "replyToId": { "type": "string", "maxLength": 128 },
        "replyToNickname": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["published", "pending", "hidden", "rejected", "deleted"] },
        "moderationSeverity": { "type": "string", "enum": ["SAFE", "REVIEW", "BLOCKED", "CRITICAL"] }
      },
      "required": ["id", "artworkId", "authorUid", "authorNickname", "authorRole", "content", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Teacher and student profile and security role metadata"
    },
    "/communityArtworks/{artworkId}": {
      "schema": "CommunityArtwork",
      "description": "Community artworks exhibited in public gallery"
    },
    "/artworkStories/{storyId}": {
      "schema": "ArtworkStory",
      "description": "Student stories linked to artworks in CÂU CHUYỆN TỪ BỨC TRANH"
    },
    "/artworkComments/{commentId}": {
      "schema": "ArtworkComment",
      "description": "Child-safe moderated community comments under artworks"
    },
    "/communityClasses/{classId}": {
      "schema": "CommunityClass",
      "description": "Classroom exhibition spaces"
    },
    "/communityLessons/{lessonId}": {
      "schema": "CommunityLesson",
      "description": "Art topics and lesson definitions"
    },
    "/communityAuditLogs/{logId}": {
      "schema": "CommunityAuditLog",
      "description": "Internal security and upload audit logs"
    },
    "/contentReports/{reportId}": {
      "schema": "ContentReport",
      "description": "Violation and inappropriate content reports"
    },
    "/lessonPlans/{planId}": {
      "schema": "LessonPlan",
      "description": "Art lesson plans created and isolated per teacher"
    },
    "/rubrics/{rubricId}": {
      "schema": "Rubric",
      "description": "4-level assessment rubrics isolated per teacher"
    },
    "/anonymousSessions/{sessionId}": {
      "schema": "AnonymousSession",
      "description": "Anonymous assignment sessions with unguessable tokens"
    },
    "/anonymousPortfolios/{portfolioId}": {
      "schema": "AnonymousPortfolio",
      "description": "Unguessable anonymous student portfolios without roster data"
    },
    "/studentAccounts/{studentId}": {
      "schema": "StudentAccount",
      "description": "Teacher-managed student accounts with hashed PINs and creative nicknames"
    },
    "/livePresentations/{sessionCode}": {
      "schema": "LivePresentationSession",
      "description": "Real-time live exhibition presentation sessions for classroom projectors and TVs"
    }
  }
}
